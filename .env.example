# ── Copier en .env et adapter ─────────────────────────────────────────
SECRET_KEY=remplacez-moi-par-une-longue-chaine-aleatoire
DEV_MODE=true                       # true : le lien de connexion est affiché à l'écran

FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# IA (optionnelle) : sans clé, extraction et adaptation passent en mode heuristique
ANTHROPIC_API_KEY=
DOSSIA_LLM_MODEL=claude-sonnet-5-5

# E-mail sortant (vide = e-mails écrits dans /data/outbox pour le développement)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Dossia <depot@dossia.fr>

# E-mail entrant (Postmark / Brevo / Mailgun → POST /api/v1/webhooks/inbound-email)
INBOUND_DOMAIN=depot.dossia.fr
INBOUND_WEBHOOK_SECRET=remplacez-moi
INBOUND_REQUIRE_SPF_DKIM=true

SOURCE_RETENTION_DAYS=180
FREE_DOSSIERS_PER_MONTH=3
